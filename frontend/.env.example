# TruthLens Frontend — environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local itself — it is already in .gitignore.

# URL of the FastAPI backend (no trailing slash)
# In production this should point to your Nginx proxy (e.g. https://yoursite.com/api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
