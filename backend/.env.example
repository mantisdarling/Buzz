# TruthLens Backend — environment variables
# Copy this file to .env and fill in real values before running locally.
# Never commit .env itself — it is already in .gitignore.

# PostgreSQL connection string
# For quick local dev you can swap in: sqlite:///./dev.db
DATABASE_URL=postgresql://truthlens:changeme@localhost:5432/truthlensdb

# Redis connection string (used by Celery and the prediction cache)
REDIS_URL=redis://localhost:6379/0

# JWT signing secret — must be at least 32 characters, use something random in prod
SECRET_KEY=please-change-this-to-a-secure-random-string-in-production

# How long access and refresh tokens live
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# Set to "production" to disable /docs and /redoc endpoints
ENVIRONMENT=development

# Optional: Sentry DSN for error tracking (leave blank to disable)
SENTRY_DSN=

# Max characters accepted in a single predict request body
MAX_TEXT_LENGTH=50000

# Rate limits per user per minute
RATE_LIMIT_PREDICT=10/minute
RATE_LIMIT_AUTH=5/minute
